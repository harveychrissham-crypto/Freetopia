{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "sdk-57"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "EAS_BUILD_DISABLE_NPM_CACHE": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "image": "sdk-57"
      },
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "EAS_BUILD_DISABLE_NPM_CACHE": "1"
      }
    }
  }
}