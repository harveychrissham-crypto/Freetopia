{
  "expo": {
    "name": "Freetopia",
    "slug": "freetopia",
    "scheme": "freetopia",
    "version": "0.2.0",
    "owner": "itsharveys-team",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./public/brand/freetopia-mark.png",
    "splash": {
      "image": "./public/brand/freetopia-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.freetopia.app"
    },
    "android": {
      "package": "com.freetopia.app",
      "adaptiveIcon": {
        "foregroundImage": "./public/brand/freetopia-mark.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b0324150-9736-45ad-94d1-01ead5e4b2dc"
      }
    }
  }
}
