{
  "expo": {
    "name": "Freetopia",
    "slug": "freetopia",
    "scheme": "freetopia",
    "version": "0.2.1",
    "owner": "itsharveys-team",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060B12",
    "icon": "./public/brand/freetopia-mark.png",
    "splash": {
      "image": "./public/brand/freetopia-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#060B12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.freetopia.app"
    },
    "android": {
      "package": "com.freetopia.app",
      "icon": "./public/brand/freetopia-mark.png",
      "adaptiveIcon": {
        "foregroundImage": "./public/brand/freetopia-mark.png",
        "backgroundColor": "#060B12"
      },
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "./plugins/withFreetopiaPortrait",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Freetopia needs access to your photos and videos so you can share them in posts and on your profile."
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Freetopia needs microphone access to record voice messages.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b0324150-9736-45ad-94d1-01ead5e4b2dc"
      }
    }
  }
}
